PORT=3000
# MongoDB Atlas / local URI. Leave empty (or "embedded") in development to use a built-in, file-persisted MongoDB.
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
# Optional: https://imagekit.io (profile photo upload + background removal)
IMAGEKIT_PRIVATE_KEY=
# Any OpenAI-compatible provider. Default: Google Gemini (key from https://aistudio.google.com/apikey)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash
# Comma-separated allowed frontend origins (blank = allow all)
CLIENT_URL=http://localhost:5173
